# Demo only: Expo embeds this key in the client bundle.
# Copy this file to .env.local and supply your ElevenLabs API key.
EXPO_PUBLIC_ELEVENLABS_API_KEY=

# Phone-reachable server URL (prefer an HTTPS tunnel, not localhost).
# Never put Instagram/X OAuth secrets here.
EXPO_PUBLIC_SERVER_API_URL=https://crack-monkfish-monthly.ngrok-free.app
